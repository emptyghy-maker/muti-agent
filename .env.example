APP_DB_URL=jdbc:mysql://127.0.0.1:3306/data_agent
APP_DB_USERNAME=app
APP_DB_PASSWORD=replace_me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace_me_if_enabled

QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=replace_me
QWEN_RESPONSE_FORMAT=json_object

# 生产运行：额度/限流/服务不可用时按顺序切换；Agent 性能评测请改为 FIXED。
LLM_ROUTING_MODE=FAILOVER
LLM_ROUTING_COOLDOWN_MS=1800000
LLM_FAILOVER_ON_TIMEOUT=false

QWEN_MODEL_DEFAULT=qwen3.7-flash-2026-07-15
QWEN_MODEL_DEFAULT_FALLBACKS=qwen3.8-flash
QWEN_MODEL_SQL=qwen3.8-27b
QWEN_MODEL_SQL_FALLBACKS=qwen3.8-max-0902,qwen3.8-flash
# 行程规划只输出决策骨架，关闭 Qwen3.8 默认 xhigh 思考并限制可见输出长度。
QWEN_PLAN_REASONING_EFFORT=none
QWEN_PLAN_MAX_TOKENS=1024
QWEN_MODEL_REPAIR=qwen3.8-flash
QWEN_MODEL_REPAIR_FALLBACKS=qwen3.7-flash-2026-07-15,qwen3.8-27b
QWEN_SEARCH_MODEL=qwen3.7-flash-2026-07-15
QWEN_SEARCH_FALLBACKS=qwen3.8-flash

# Prompt/Agent A-B 评测专用：使用带日期的固定版本；评测代码不读取生产 fallback 列表。
QWEN_EXP_MODEL_DEFAULT=qwen3.7-flash-2026-07-15
QWEN_EXP_MODEL_SQL=qwen3.8-27b
QWEN_EXP_REASONING_EFFORT=none

JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRATION=3600000

# 短期上下文：先开基线，再开 TurnContext 影子模式；确认差异后才启用新解析补充。
CONTEXT_BASELINE_ENABLED=false
CONTEXT_BASELINE_LOG_ENABLED=true
TURN_CONTEXT_ENABLED=false
TURN_CONTEXT_SHADOW_ENABLED=true
TURN_CONTEXT_USE_NEW_PARSER=false

# AgentContext 与上下文预算：先保持 shadow=true；按 ATTRACTION,FOOD,HOTEL,PLANNING 顺序逐个灰度。
CONTEXT_OPTIMIZATION_ENABLED=false
CONTEXT_OPTIMIZATION_SHADOW_ENABLED=true
CONTEXT_BUDGET_POLICY_VERSION=context-budget-v1
CONTEXT_OPTIMIZATION_ROLLOUT_ROLES=
CONTEXT_MAX_SECTION_BYTES=1048576
CONTEXT_ATTRACTION_K=12
CONTEXT_FOOD_K=16
CONTEXT_HOTEL_K=8
